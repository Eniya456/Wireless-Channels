# ==========================================
# Wireless Channel Simulation & ML Platform
# Environment Configuration Template
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=True

# Storage Mode: "local" (default, runs fully offline) or "firebase" (Google Cloud Firestore)
STORAGE_MODE=local
LOCAL_STORAGE_PATH=backend/data/experiments.json

# Optional Cloud Configuration (Required only when STORAGE_MODE=firebase)
# Path to your downloaded serviceAccountKey.json from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIRESTORE_COLLECTION=wireless_experiments

# Machine Learning Artifacts Path
MODEL_DIR=backend/data/models
